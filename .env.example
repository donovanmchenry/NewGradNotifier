EMAIL_RECIPIENT=dzmchenry@gmail.com
EMAIL_SENDER=NewGrad Notifier <onboarding@resend.dev>
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Optional SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dzmchenry@gmail.com
SMTP_PASSWORD=
SMTP_TLS=true
IMMEDIATE_ALERTS_ENABLED=true
IMMEDIATE_ALERT_THRESHOLD=92

DB_BACKEND=sqlite
SQLITE_PATH=./data/newgradnotifier.db

# Optional DATABASE_URL override for a future hosted PostgreSQL migration
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

OPENAI_API_KEY=
OPENAI_ENABLED=true
SEND_EMPTY_DIGEST=false
FAILURE_ALERTS_ENABLED=true
TRACKING_ENABLED=false
TRACKING_BASE_URL=
TRACKING_SECRET=
TRACKING_DASHBOARD_USERNAME=donovan
TRACKING_DASHBOARD_PASSWORD=
TRACKING_HOST=127.0.0.1
TRACKING_PORT=8765
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODELS=gpt-4o-mini
RUN_TIME_LOCAL=08:00
TIME_ZONE=America/New_York

# Optional zero2sudo Instagram Story watcher
STORY_WATCH_ENABLED=true
STORY_WATCH_USERNAME=zero2sudo
STORY_WATCH_URL=https://insta-stories-viewer.com/zero2sudo/
STORY_WATCH_STATE_PATH=./data/zero2sudo-story-state.json
STORY_WATCH_NOTIFY_EXISTING=false
STORY_WATCH_OCR_ENABLED=true
STORY_WATCH_ATTACH_IMAGES=true
STORY_WATCH_MAX_ATTACHMENT_BYTES=6291456
